# ---------------------------------------------------------------------------
# Copy this file to .env.local for local dev, and paste the same values into
# Vercel -> Project -> Settings -> Environment Variables for production.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase -> Project Settings -> API -> service_role (SECRET).
# Server-only: used by the admin panel to insert/update/delete products and
# upload images. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single shared password for /admin (Phase 1 — no user accounts yet).
# Also used to sign the admin session cookie, so changing it logs everyone out.
ADMIN_PASSWORD=change-me-to-something-long

# Storefront copy / contact details (safe to expose to the browser)
NEXT_PUBLIC_STORE_NAME=Nisha Ghumti Fancy
NEXT_PUBLIC_STORE_TAGLINE=Everyday clothing, made to be lived in.

# WhatsApp number in international format, digits only, no + and no spaces.
# Nepal example: 9779812345678
NEXT_PUBLIC_WHATSAPP_NUMBER=9779816454914

NEXT_PUBLIC_STORE_EMAIL=ayaanshah1667@gmail.com
NEXT_PUBLIC_STORE_ADDRESS=Butwal 12, Tamnagar
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/akhtarshah7788660?stkn=a2k4NnJsc3k4OTY2
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61591790385915
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@nisha_fancy_7?_r=1&_t=ZS-99hMaEGXHq0
